# Copie este arquivo para .env e preencha com seus valores reais
# Nunca versione o arquivo .env com dados reais

PORT=3000

# Supabase — cole a connection string do painel:
# Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres

# Supabase — Settings → API (necessário para validar login/token no backend)
SUPABASE_URL=https://[SEU_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=cole_a_anon_key_aqui

# Emails que viram admin automaticamente no primeiro login (separados por vírgula)
ADMIN_EMAILS=seu@email.com

# JWT — troque por uma string longa e aleatória (obrigatório — servidor não sobe sem isso)
JWT_SECRET=troque_isso_por_uma_chave_segura_em_producao

# CORS — domínios permitidos separados por vírgula (ex: https://meusite.vercel.app)
CORS_ORIGIN=http://localhost:3000
